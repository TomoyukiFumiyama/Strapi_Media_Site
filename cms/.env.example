HOST=0.0.0.0
PORT=1337
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me-api-token-salt
ADMIN_JWT_SECRET=replace-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=replace-me-transfer-token-salt
JWT_SECRET=replace-me-jwt-secret
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# Cloudflare R2 upload provider (S3 compatible)
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-me-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-me-r2-secret-access-key
CLOUDFLARE_R2_ENDPOINT=https://replace-me-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=replace-me-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://media.example.com
CLOUDFLARE_R2_REGION=auto
