{
  "kind": "collectionType",
  "collectionName": "job_listing_pages",
  "info": {
    "singularName": "job-listing-page",
    "pluralName": "job-listing-pages",
    "displayName": "job-listing-page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "page_type": {
      "type": "enumeration",
      "enum": [
        "area",
        "condition",
        "area-condition",
        "custom"
      ],
      "default": "custom",
      "required": true
    },
    "area": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::area.area"
    },
    "job_search_condition": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::job-search-condition.job-search-condition"
    },
    "hero": {
      "type": "component",
      "component": "shared.hero"
    },
    "lead_text": {
      "type": "richtext"
    },
    "job_list_heading": {
      "type": "string"
    },
    "job_list_intro": {
      "type": "text"
    },
    "featured_jobs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::job-posting.job-posting"
    },
    "featured_columns": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::column-article.column-article"
    },
    "column_section_heading": {
      "type": "string"
    },
    "column_section_body": {
      "type": "richtext"
    },
    "content_blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.rich-text",
        "blocks.image-text",
        "blocks.quote",
        "blocks.faq-section",
        "blocks.cta-banner",
        "blocks.stats-section",
        "blocks.related-posts",
        "blocks.related-case-studies",
        "blocks.download-cta",
        "blocks.office-info",
        "blocks.column-section"
      ]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo"
    },
    "canonical_url": {
      "type": "string"
    },
    "noindex": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  }
}
