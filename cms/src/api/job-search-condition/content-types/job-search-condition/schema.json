{
  "kind": "collectionType",
  "collectionName": "job_search_conditions",
  "info": {
    "singularName": "job-search-condition",
    "pluralName": "job-search-conditions",
    "displayName": "job-search-condition"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "condition_type": {
      "type": "enumeration",
      "enum": [
        "employment-type",
        "work-style",
        "salary",
        "benefit",
        "experience",
        "qualification",
        "industry",
        "keyword"
      ],
      "default": "keyword",
      "required": true
    },
    "search_label": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo"
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  }
}
